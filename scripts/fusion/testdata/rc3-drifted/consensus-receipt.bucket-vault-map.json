{
  "schema_version": "1.0",
  "canonical_bucket_order": [
    "agent_tokens",
    "conservative_defi_yield",
    "protocol_tokens",
    "real_world_assets"
  ],
  "buckets": [
    {
      "bucket": "agent_tokens",
      "vault_symbol": "rmAGENT",
      "deployment_address_json_pointer": "/vault_addresses/rmAGENT"
    },
    {
      "bucket": "conservative_defi_yield",
      "vault_symbol": "rmUSDC",
      "deployment_address_json_pointer": "/vault_addresses/rmUSDC"
    },
    {
      "bucket": "protocol_tokens",
      "vault_symbol": "rmPROTO",
      "deployment_address_json_pointer": "/vault_addresses/rmPROTO"
    },
    {
      "bucket": "real_world_assets",
      "vault_symbol": "rmRWA",
      "deployment_address_json_pointer": "/vault_addresses/rmRWA"
    }
  ],
  "deployment_address_contract": {
    "scope": "per-deployment",
    "manifest_identity_fields": ["deployment_id", "chain_id"],
    "vault_addresses_field": "vault_addresses",
    "required_vault_symbols": ["rmUSDC", "rmPROTO", "rmAGENT", "rmRWA"],
    "address_pattern": "^0x[0-9a-fA-F]{40}$",
    "missing_address_policy": "the deployment is not receipt-capable; never substitute a global or zero address"
  }
}
