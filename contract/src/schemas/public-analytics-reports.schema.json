{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotmoney.network/contract/schemas/public-analytics-reports.schema.json",
  "title": "GET /api/public/analytics/reports (the list; ?run= and ?vintage= answer the report bytes themselves)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "limit",
    "reports",
    "nextCursor"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_id",
          "run_key",
          "asof",
          "checksum",
          "byte_length",
          "created_at"
        ],
        "properties": {
          "report_id": {
            "type": "integer",
            "minimum": 1
          },
          "run_key": {
            "type": "string"
          },
          "asof": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
