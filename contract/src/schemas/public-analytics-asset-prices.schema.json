{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotmoney.network/contract/schemas/public-analytics-asset-prices.schema.json",
  "title": "GET /api/public/analytics/asset-prices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "limit",
    "rows",
    "nextCursor"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "price_date",
          "symbol",
          "time_basis",
          "price_usd",
          "currency",
          "source",
          "pool_key",
          "token_address",
          "observed_at",
          "fetched_at",
          "config_identity"
        ],
        "properties": {
          "price_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "symbol": {
            "type": "string"
          },
          "time_basis": {
            "const": "utc-daily-close"
          },
          "price_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currency": {
            "const": "USD"
          },
          "source": {
            "type": "string"
          },
          "pool_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "token_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "config_identity": {
            "type": "string"
          }
        }
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
