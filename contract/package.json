{
  "name": "@robotmoney/contract",
  "version": "0.1.0",
  "description": "HTTP API contract shared by the robotmoney frontend and backend. Types + route paths only, zero runtime deps.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./routes": "./src/routes.js",
    "./consensus-receipt": {
      "types": "./src/consensus-receipt.d.ts",
      "import": "./src/consensus-receipt.js"
    },
    "./fixtures/consensus-receipt.*": "./src/__fixtures__/consensus-receipt.*"
  },
  "files": ["src"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robotmoney/robotmoney-frontend.git",
    "directory": "contract"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "bun test tests/unit",
    "test:live": "bun test tests/live"
  },
  "license": "MIT"
}
