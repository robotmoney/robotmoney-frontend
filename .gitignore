node_modules/
# Secret-bearing env files. A GLOB with an explicit negation, not two
# exact-match lines: `.env` + `.env.local` left `.env.bak`, `.env.prod`,
# `.env.staging` — every ad-hoc copy an operator actually makes — committable,
# and this repo's `.env` carries a FUNDED OPENCODE_API_KEY, so one `git add -A`
# was all it took to publish it. The negation keeps the tracked, secret-free
# template committable (and documents that intent if it is ever re-added).
.env*
!.env.example
*.log
.DS_Store
dist/
playwright-report/
test-results/

# Cloudflare Pages deploy dir assembled by scripts/cloudflare-statics.sh.
_site/

# The api process's STATIC_DIR assembly (frontend/public + the per-route
# prerendered HTML), built by scripts/static-assembly.sh and bind-mounted into
# the api container by docker-compose.yml. A BUILD OUTPUT, never source —
# every byte in it is derived from frontend/public and seo.js's table.
_static/

# The real-inference admission record a CI/demo run renders (issue #373). A CI
# ARTIFACT, never source: scripts/lib/demo-main.ts writes it and e2e-onboarding.yml folds
# it into the job summary and uploads it.
onboarding-admission-record.md

# The production drift auditor's report (the schedule-only, non-gating
# .github/workflows/production-drift-audit.yml run). Same shape as the record
# above: a CI ARTIFACT, never source. scripts/production-drift-audit.ts writes
# it to the working directory, the workflow folds it into $GITHUB_STEP_SUMMARY
# and uploads it — and a developer running the auditor by hand to see what it
# would say would otherwise leave an untracked file in the tree, which
# backend/scripts/lib/rollout-receipt.ts reads as repo_dirty.
production-drift-audit-report.md

# Agent handoff scratch: written for the next session, stale the moment it is
# read. Tracked once by mistake (7d1cd13b), which is why it is named here.
next_agent.md

# Agent/loop runtime state only — demo state files, logs, caches, plan backups.
# Never source, never committed, so the whole directory is ignored.
.agents/
.audit-scratch/

# Same-directory temp files the seed writers rename over their committed
# artifact (backend/src/projects/seed/roster-seed.ts
# replaceRosterSeedAtomically, analytics/extract/*-seed-generator.ts). A crash
# between the write and the rename orphans one next to the real artifact, where
# `git add -A` would happily commit a ~1 MB near-duplicate.
*.tmp-[0-9]*

# ad-hoc stack-orchestrator environment (docs/technical/stack-orchestrator.md)
.stack-env/

# Also ignore node_modules when it is a SYMLINK (a worktree pointing at the
# main checkout's install). The trailing-slash form above matches directories
# only, so a symlink named node_modules was not ignored and got committed.
/node_modules
/backend/node_modules

# Agent scratch: worktrees and session state. Untracked content here used to
# make every rollout receipt record repo_dirty=true against an otherwise clean
# tree (backend/scripts/lib/rollout-receipt.ts reads `git status --porcelain`).
.claude/
