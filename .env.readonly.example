# Copy to .env.readonly and fill in the rm_readonly role's connection details.
# Consumed by backend/scripts/preflight-upgrade.ts — see
# docs/runbooks/v0-2-2-rollout.md §3/§4 for how to provision the role.
#
# This is a SEPARATE file from .env, and holds a SEPARATE, read-only role's
# credentials — never the application's writer DATABASE_URL. Discrete keys,
# not a pasted postgres:// URL: the script builds and URI-escapes the
# connection string itself, so a password containing `@ : / ? # [ ] %` or a
# space is safe here without restricting the alphabet you generate it from.
#
# All five keys below are required. sslmode is optional and defaults to
# "require" if omitted — the managed cluster this points at always needs TLS.
#
# KEEP THIS FILE TO THESE KEYS. Unrelated secrets do not belong here — in
# particular NOT a funded OPENCODE_API_KEY, which belongs in .env. The loader
# ignores extra keys, so a stray one fails silently rather than loudly, and
# this file's whole purpose is to be the narrow, low-privilege credential you
# can hand to a preflight run on a staging host. Widening it to "the file
# where credentials go" defeats that: the runbook's backup path (docs/runbooks
# §5) is deliberately one read-only role against a replica, and anything else
# stored alongside inherits that file's blast radius for no benefit.
# Note the rehearsal tooling does not need an inference key at all —
# stage-rehearsal.ts writes AGENT_MODEL=free into its own worktree .env
# precisely so it never spends the funded key.

host=
port=25060
username=rm_readonly
password=
database=defaultdb
# sslmode=require
