{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "autoupdate": false,
  "permission": {
    "*": "deny",
    "robotmoney_*": "allow"
  },
  "mcp": {
    "robotmoney": {
      "type": "remote",
      "url": "http://mcp:8788/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:ROBOTMONEY_MEMBER_TOKEN}"
      },
      "timeout": 10000
    }
  }
}
