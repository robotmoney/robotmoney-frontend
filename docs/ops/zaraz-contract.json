{
  "description": "Review checklist fixture, NOT an importable Cloudflare configuration",
  "hostname": "robotmoney.network",
  "loader": "/cdn-cgi/zaraz/i.js",
  "autoInject": false,
  "iframeInjection": false,
  "spaSupport": false,
  "dataLayerCompatibility": false,
  "automaticPageviewActions": false,
  "automaticConsentModal": false,
  "consent": { "requiredPurpose": "Analytics", "analytics_storage": "purpose", "ad_storage": "denied", "ad_user_data": "denied", "ad_personalization": "denied" },
  "trigger": { "eventName": "rm_page_view", "publicOnly": true },
  "ga4Action": {
    "eventName": "page_view",
    "fields": { "page_title": "{{ client.page_title }}", "page_location": "{{ client.page_location }}", "page_path": "{{ client.page_path }}" }
  },
  "privacy": { "removeUrlQueryParameters": true, "removeExternalReferrers": true, "queryAllowlist": [], "stripFragments": true, "blockPrivilegedContext": true }
}
