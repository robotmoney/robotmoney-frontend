{
  "name": "robotmoney-frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Single-folder home for the split-ready frontend/ + backend/ + contract/.",
  "scripts": {
    "postinstall": "bun install --cwd backend",
    "sync-contract": "bun scripts/sync-contract.ts",
    "check-contract": "bun scripts/sync-contract.ts --check",
    "check-docs": "bash scripts/check-docs-analytics.sh",
    "check:contribution": "bun scripts/check-contribution.ts",
    "bootstrap": "bun run --cwd backend prod-bootstrap",
    "test": "bun test scripts/tests",
    "test:unit": "bun test scripts/tests/unit",
    "test:integration": "bun test scripts/tests/integration",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "bun scripts/preview-server.ts",
    "prerender": "bun scripts/prerender.ts",
    "static:assemble": "bash scripts/static-assembly.sh",
    "goldens:update": "bun scripts/update-goldens.ts",
    "smoke": "bun scripts/smoke.ts",
    "smoke:stage": "bun scripts/smoke-stage.ts",
    "eval": "cd evals && EVAL_SUITE_RUN_ID=\"${EVAL_SUITE_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)-$$}\" bun test",
    "onboarding-eval": "bun scripts/onboarding-eval-local.ts",
    "smoke:down": "bun scripts/smoke-down.ts",
    "smoke:status": "bun scripts/smoke-status.ts",
    "smoke:clean": "bun scripts/smoke-clean.ts",
    "smoke:reap": "bun scripts/smoke-reap.ts",
    "smoke:capture": "bun run --cwd backend scripts/smoke-twin-capture.ts",
    "credentials": "bun scripts/gitops-credentials.ts",
    "credentials:check": "bun scripts/gitops-credentials.ts --check",
    "smoke:twin": "bun scripts/smoke-twin.ts",
    "smoke:twin --once": "bun scripts/smoke-twin-rehearse.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@robotmoney/contract": "file:./contract",
    "@types/bun": "^1.2.0",
    "alpinejs": "3.14.9",
    "chart.js": "4.5.1",
    "p5": "1.11.2",
    "typescript": "^5.9.3"
  }
}
